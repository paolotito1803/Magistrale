VU = (slot_v1, T).VU + (slot_v32, T).VU;

// w:     99
// w - 1: 01
VF = (slot_v1, 99 * T).VF + (slot_v1, 01 * T).Delay + (slot_v32, T).VF;
Delay = (delay, delta).VF + (slot_v32, T).VF;


Slot1 <slot_v1, slot_v32> (VU <slot_v1, slot_v32> VF)
