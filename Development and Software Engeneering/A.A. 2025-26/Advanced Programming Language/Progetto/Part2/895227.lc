-- ==============================================================================
-- Exercise 1: Programming in the Lambda Calculus
-- ==============================================================================

-- Basic Church Encodings required for the exercises
TRUE = \x. \y. x
FALSE = \x. \y. y
NOT = \b. b FALSE TRUE

ZERO = \f. \x. x
SUCC = \n. \f. \x. f (n f x)
IS_ZERO = \n. n (\x. FALSE) TRUE

-- Predecessor (standard Church encoding)
PRED = \n. \f. \x. n (\g. \h. h (g f)) (\u. x) (\u. u)

-- Subtraction (m - n)
SUB = \m. \n. n PRED m

-- (a) Comparisons
--leq
leq = \m. \n. IS_ZERO (SUB n m)

-lt 
lt = \m. \n. NOT (leq m n)

-- Test cases for (a)
-- leq 2 3 -> TRUE
-- leq 3 3 -> TRUE
-- leq 3 2 -> FALSE
-- lt 2 3  -> TRUE
-- lt 3 3  -> FALSE
-- lt 0 1  -> TRUE

-- (b) Integer Division
-- Call-By-Name Y-combinator for recursion
Y = \f. (\x. f (x x)) (\x. f (x x))

div_rec = \r. \m. \n. (lt m n) ZERO (SUCC (r (SUB m n) n))
div = Y div_rec

-- Test cases for (b)
-- div 6 3 -> 2 (Church)
-- div 7 2 -> 3 (Church)
-- div 2 5 -> 0 (Church)

-- (c) Filter
nil = \c. \n. n
cons = \h. \t. \c. \n. c h (t c n)

filter = \p. \l. l (\h. \t_acc. (p h) (cons h t_acc) t_acc) nil

-- Test case for (c)
-- keep only elements > 3: \x. lt 3 x
-- filter (\x. lt 3 x) [1, 2, 3, 4, 5, 6] -> [4, 5, 6]

-- ==============================================================================
-- Exercise 2: Call-by-Name vs Call-by-Value
-- ==============================================================================

A = \f. \x. f (f x)
B = \x. x
W = \x. x x x

-- (a) Divergence
-- Evaluate: A B (W W)
--
-- Note on the prompt: Standard lambda calculus evaluation shows that A B (W W) 
-- DIVERGES under BOTH strategies, because B is the identity function (\x.x), 
-- which does not discard its argument. 
-- 
-- Call-By-Name (CBN) trace:
-- A B (W W) 
-- -> (\x. B (B x)) (W W)   [Apply A to B]
-- -> B (B (W W))           [Apply to (W W)]
-- -> (\x. x) (B (W W))     [Expand B]
-- -> B (W W)               [Apply identity]
-- -> (\x. x) (W W)         [Expand B]
-- -> W W                   [Apply identity]
-- -> W W W                 [Diverges!]
--
-- Call-By-Value (CBV) trace:
-- CBV evaluates arguments before application. 
-- The argument (W W) immediately diverges to (W W W) -> (W W W W) etc.
-- Diverges immediately!
--
-- Swap argument order: A (W W) B
-- CBN: (\f.\x.f(fx)) (W W) B -> (\x. (W W) ((W W) x)) B -> (W W) ((W W) B) -> Diverges.
-- CBV: Evaluates (W W) first -> Diverges.
-- Both diverge here as well. 


-- (b) Wasted work
-- We need a term G that uses its argument multiple times.
G_waste = \x. x x

-- Test: G_waste (B B)
-- CBV: evaluates (B B) -> B once. Then applies (\x. x x) to B -> B B -> B. (Argument evaluated ONCE).
-- CBN: applies G_waste to (B B) -> (B B) (B B). 
-- Now the argument (B B) is evaluated TWICE in the resulting expression. 

-- (c) Short-circuit evaluation
-- Standard Church IF evaluates arguments strictly in CBV.
IF = \b. \t. \f. b t f

-- If we do: IF TRUE (B B) (W W)
-- In CBV, both (B B) and (W W) are evaluated before IF is called. (W W) diverges. No short-circuit!

-- Short-circuit IF (ifc): We use "thunks" (functions taking a dummy argument) to delay evaluation.
ifc = \b. \t_thunk. \f_thunk. b t_thunk f_thunk B

-- Demonstration:
-- t_thunk = \u. B B
-- f_thunk = \u. W W
-- ifc TRUE (\u. B B) (\u. W W)
-- CBV evaluates the thunks (which are already values: abstractions) and passes them to ifc.
-- -> TRUE (\u. B B) (\u. W W) B
-- -> (\u. B B) B
-- -> B B -> B  (Terminates! The divergent W W is never evaluated).