// To use environment variables open api_tests_users.http (in intellij)
// at the top of the editor panel in dropdown menu that says "No Environment"
// click it and select dev

### LOGIN COACH
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "coach1@mail.com",
  "password": "{{user_password}}"
}

> {%
    client.global.set("coach_token", response.body.token);
%}

### 1. GET TEAMS
GET http://localhost:8080/api/teams
Authorization: Bearer {{coach_token}}

### 2. UPDATE STADIUM
POST http://localhost:8080/api/teams/id_coach_1/stadium
Content-Type: application/json
Authorization: Bearer {{coach_token}}

{
  "name": "Inferno Arena",
  "maxSeats": 10000
}

### 3. ADD PLAYER
POST http://localhost:8080/api/teams/id_coach_1/players
Content-Type: application/json
Authorization: Bearer {{coach_token}}

{
  "name": "New Star Player",
  "number": 99,
  "role": "PLAYER"
}

### 4. UPDATE PLAYER
PUT http://localhost:8080/api/teams/id_coach_1/players/1
Authorization: Bearer {{coach_token}}
Content-Type: application/json

{
  "name": "Donkey Kong",
  "number": 17,
  "role": "PLAYER"
}

### 5. DELETE PLAYER
DELETE http://localhost:8080/api/teams/id_coach_1/players/17
Authorization: Bearer {{coach_token}}

### 6. VERIFY EVERYTHING
GET http://localhost:8080/api/teams
Authorization: Bearer {{coach_token}}

### 7. GET STADIUM NAME
GET http://localhost:8080/api/teams/stadium/Inferno Arena
Authorization: Bearer {{coach_token}}
